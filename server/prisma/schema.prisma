generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String
  plainPassword     String?
  name              String
  role              String    @default("MANAGER")
  // ТЗ: Частное лицо — отдельная роль, привязка к компании
  assignedCompanyId String?
  contactPhone      String?
  // ТЗ: город курьера. Курьер видит только заявки своего города —
  // фильтр стоит и на сервере (getRequests), и в интерфейсе.
  // Пусто = город не назначен: список пустой, а не «видно всё».
  // Для остальных ролей поле не используется.
  city              String    @default("")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  requests          Request[]
}

model Company {
  id             String    @id @default(uuid())
  name           String
  bin            String    @unique
  address        String
  factAddress    String    @default("")
  phone          String    @default("")
  director       String    @default("")
  email          String    @default("")
  bank           String    @default("")
  bik            String    @default("")
  account        String    @default("")
  kbe            String    @default("")
  bankDetails    String    @default("")
  managerDetails String    @default("")
  // ТЗ: Компании — поле для PNG с печатью и подписью
  stamp          String?
 // ТЗ: Организации — нельзя удалять, только аннулировать
  status         String    @default("active")
  // ТЗ: ставка налога в % (для расчёта расхода "Налоги"), 0 = нет налога
  taxRate        Float     @default(0)
  // ТЗ: налоговый режим компании: 'none' | 'simplified' | 'our'
  //   simplified (упрощёнка): налог = оборот × (taxRate% + taxExtra%)
  //   our (ОУР): НДС по vatRate, затем КПН по kpnRate с остатка —
  //   порядок вычетов см. в src/shared/tax/calcTax.js
  taxMode        String    @default("none")
  // Доп. сбор % (напр. 1% за снятие наличных у TASU KZ) — для упрощёнки
  taxExtra       Float     @default(0)
  // Ставка НДС % (для режима ОУР)
  vatRate        Float     @default(0)
  // ТЗ: ставка КПН % (для режима ОУР). Считается ПОСЛЕ вычета НДС и суммы
  // официально купленной перевозки. По умолчанию 0 — пока ставку не заполнят,
  // КПН равен нулю и отчёт считается как до появления этого поля.
  kpnRate        Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  logo           String?
  requests       Request[]
}

model Request {
  id          String    @id @default(uuid())
  status      String    @default("Заявка")
  date        String
  companyId   String
  managerId   Int
  type        String    @default("REQUEST")
  route       String?
  cargo       String?
  docNumber   String?   @unique
  // ТЗ: движение груза по сканированию QR — забрал → погрузил → представитель
  // принял → выдал. ОТДЕЛЬНОЕ поле, не status: status держит рабочий процесс
  // документа (act/sent/done/deferred), на нём стоят вкладки и фильтры
  // разделов. Груз может быть «на фуре», пока накладная «Обработана» —
  // это разные оси, смешивать их в одном поле нельзя.
  cargoStatus   String?   @default("")
  cargoStatusAt DateTime?
  // ТЗ: одноразовые ссылки для наёмных водителей и представителей — вместо
  // учёток и кабинетов. Массив, а не пара полей: на одну накладную нужны
  // РАЗНЫЕ ссылки (водителю и получателю), а после погашения выдают новую,
  // не затирая историю выдач.
  // [{ token, purpose, createdAt, expiresAt, usedAt, revokedAt, issuedBy }]
  accessTokens  Json?
  // ТЗ: электронная подпись СМР — получатель расписывается пальцем по ссылке.
  // ОТДЕЛЬНАЯ колонка, не details: details переписываются целиком при каждом
  // сохранении заявки, а подпись — юридический след, затирать её обычной
  // правкой нельзя.
  // [{ role, name, image, signedAt, token }]
  signatures    Json?
  totalSum    String?   @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  details     String?
  // ТЗ: Аналитика — фильтр по оплачено/неоплачено
  isPaid                  Boolean   @default(false)
  paidAt                  DateTime?
  // ТЗ: Бухгалтер — финальное завершение работы
  isFullyCompleted        Boolean   @default(false)
  fullyCompletedAt        DateTime?
  // ТЗ: Бухгалтер — если отредактировали после завершения, должна попасть в сток как новая
  reEditedAfterCompletion Boolean   @default(false)
  company     Company  @relation(fields: [companyId], references: [id])
  manager     User     @relation(fields: [managerId], references: [id])

  @@index([status])
  @@index([companyId])
  @@index([type])
  @@index([isPaid])
  @@index([isFullyCompleted])
}

model Contract {
  id               String   @id @default(uuid())
  number           String
  date             String
  type             String
  role             String?
  status           String   @default("active")
  companyId        String
  companyName      String?
  customerName     String?
  actId            String?
  details          String?
  counterpartyId   String?
  directorName     String?
  directorPosition String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Counterparty {
  id           String   @id @default(uuid())
  name         String
  phone        String   @default("")
  email        String   @default("")
  companyName  String   @default("")
  bin          String   @default("")
  address      String   @default("")
  bank         String   @default("")
  bik          String   @default("")
  account      String   @default("")
  kbe          String   @default("")
  director     String   @default("")
  // ТЗ: Контрагенты — добавить контактный номер
  contactPhone String?  @default("")
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Expense {
  id          String   @id @default(uuid())
  date        String
  category    String
  description String   @default("")
  amount      Float
  docNumber   String   @default("")
  // ТЗ: Расход на существующую накладную (по умолчанию категория "Перевозка")
  requestId   String?
  companyId   String?
  userId      Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([requestId])
}

model Tariff {
  id            String   @id @default(uuid())
  // ТЗ: направление тарифа — из какого города. Старые тарифы = Алматы (по умолчанию).
  fromCity      String   @default("Алматы")
  city          String
  pricePerKg    Float    @default(0)
  deliveryPrice Float    @default(0)
  // ТЗ: Тарифы частных лиц — диапазоны (до 10, до 20, до 30, до 80, до 150, до 300, до 600 кг)
  weightRanges  Json?
  // ТЗ: Возможность добавить доп. сумму к тарифу частного лица
  extraSum      Float    @default(0)
  // Пометка что тариф для частных лиц
  isPrivate     Boolean  @default(false)
  companyId     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Уникальность теперь по паре направление+назначение (city хранит суффиксы категорий).
  @@unique([fromCity, city])
}

model Batch {
  id           String    @id @default(uuid())
  number       String    @unique
  city         String
  driverName   String    @default("")
  driverPhone  String    @default("")
  carNumber    String    @default("")
  deliveryCost String    @default("")
  requestIds   String
  companyId    String?
  status       String    @default("created")
  // ТЗ: Партии — Активные / Сформированные
  isFormed     Boolean   @default(false)
  formedAt     DateTime?
  // Сохранённая ведомость (HTML/JSON для печати)
  vedomostData String?
  totalSeats   Int       @default(0)
  totalWeight  Float     @default(0)
  // Партия: перевозчик / представитель / грузчики из справочников
  carrierId        String?
  representativeId String?
  loadersCount     Int       @default(0)
  // ТЗ: партия может входить только в ОДНУ ведомость перевозчика одновременно
  carrierVedomostId String?
  // ТЗ: перевозку покупают и официально, и за наличные. Официальная проходит
  // по учёту и уменьшает базу КПН, неофициальная — нет. Отмечает менеджер или
  // бухгалтер. По умолчанию false: молча уменьшать налог у старых партий,
  // про которые ничего не известно, нельзя.
  carrierOfficial   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isFormed])
}

model Carrier {
  id        String   @id @default(uuid())
  name      String
  phone     String   @default("")
  // Старое одиночное поле — НЕ удаляем: по нему читаются записи, заведённые до
  // появления списка городов (fallback cities ?? [city]).
  city      String   @default("")
  // Города обслуживания — JSON-массив строк. Один перевозчик может работать
  // по нескольким городам; по нему сужается выбор в ведомости и в форме партии.
  cities    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Representative {
  id        String   @id @default(uuid())
  name      String
  phone     String   @default("")
  // Старое одиночное поле — оставлено для обратной совместимости (см. Carrier).
  city      String   @default("")
  // Города обслуживания — JSON-массив строк.
  cities    String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ТЗ: Ведомость перевозчика — формируется ТОЛЬКО из уже сформированных партий
// (не напрямую из накладных), содержит авторасчёт сумм для перевозчика,
// грузчиков и представителя по тарифам из справочника Тарифы
model CarrierVedomost {
  id                String   @id @default(uuid())
  number            String   @unique
  companyId         String?
  // JSON-массив id партий (Batch), из которых сформирована ведомость
  batchIds          String
  // JSON-снэпшот: разбивка по каждой партии (город, вес, тарифы, суммы) — для печати
  data              String
  totalWeight       Float    @default(0)
  carrierSum        Float    @default(0)
  loaderSum         Float    @default(0)
  representativeSum Float    @default(0)
  // Аннулирование — ПРЕЖНИЙ механизм, кнопки в интерфейсе больше нет.
  // Поля оставлены для истории: по ним видно, каким способом убрали старые
  // ведомости. Из списка такие записи скрыты наравне с deleted.
  annulled          Boolean  @default(false)
  annulledAt        DateTime?
  // ТЗ: удаление ведомости — МЯГКОЕ. Запись из базы не стирается никогда,
  // номер закреплён за ней навсегда (genVedomostNumber считает max по всем
  // записям, включая удалённые). Партии при удалении освобождаются
  // (Batch.carrierVedomostId = null) и возвращаются в «Сформированные».
  deleted           Boolean  @default(false)
  deletedAt         DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}